<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PharmacyNews daily edition</title><link rel="stylesheet" href="/atlas/style.css"><link rel="stylesheet" href="/atlas/style.css"><link rel="stylesheet" href="/css/site.css"></head><body><%- include('partials/site-masthead', { active: 'news' }) %><main id="main"><a href="/">PharmacyNews.ai</a><h1>Daily edition · <%= edition.day %></h1><p><%= edition.note %></p><% if(!articles.length){ %><p>No currently available reviewed articles in this edition. This is not evidence of no developments worldwide.</p><% } %><% articles.forEach(a=>{ %><article><h2><a href="/article/<%= a.slug %>"><%= a.title %></a></h2><p><%= a.summary %></p><p><%= a.source %> · <%= a.provenance?.published_at||a.date_published||'Publication date unknown' %></p></article><% }) %><% if(typeof archived!=='undefined'&&archived){ %><p><%= archived %> item<%= archived===1?'':'s' %> in this edition are now older than 90 days and are no longer listed as current news.</p><% } %><% if(unavailable){ %><p><%= unavailable %> earlier references have been withdrawn or superseded; consult the current archive.</p><% } %></main><%- include('partials/footer') %></body></html>
