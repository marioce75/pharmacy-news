<%- include('partials/site-top', { title: article.title + ' | PharmacyNews.ai', description: article.summary.slice(0, 300), active: 'news', canonicalPath: '/article/' + article.slug, noindex: !!article.archived }) %>
<main id="main" class="page">
  <p><a href="/news/<%= article.desk %>">← <%= article.desk_label %></a></p>
  <article>
    <p class="news-list"><span class="badge-status ok">Reviewed summary</span><% if (article.archived) { %> <span class="badge-status off">Archive</span><% } %></p>
    <% if (article.archived) { %><div class="notice" role="note"><strong>Archive.</strong> This story is older than <%= typeof archiveDays === 'undefined' ? 90 : archiveDays %> days and is no longer listed as current news. It may have been superseded; check the original source for the latest information.</div><% } %>
    <h1><%= article.title %></h1>
    <p class="muted"><%= article.source || 'Source unspecified' %> ·
      <% if (article.date_published) { %>Published <time datetime="<%= article.date_published %>"><%= article.date_published %></time><% } else { %>Publication date unknown<% } %>
      <% if (article.retrieved_at) { %> · Collected <%= String(article.retrieved_at).slice(0, 10) %><% } %>
      <% if (article.reviewed_at) { %> · Reviewed <%= String(article.reviewed_at).slice(0, 10) %><% } %></p>
    <p class="lede"><%= article.summary %></p>
    <% if (article.source_url) { %><p><a href="<%= article.source_url %>" target="_blank" rel="noopener noreferrer">Read the original at <%= article.source || 'the source' %> ↗</a></p><% } %>
    <div class="article__body"><%- article.body_html %></div>
    <% if (article.correction_note) { %><div class="notice"><strong>Correction or update.</strong> <%= article.correction_note %></div><% } %>
    <details><summary>Source and review details</summary>
      <p>Evidence type: <%= article.evidence_type || 'Unclassified' %><% if (article.rights_attribution) { %> · Attribution: <%= article.rights_attribution %><% } %><% if (article.jurisdiction.length) { %> · Source jurisdiction: <%= article.jurisdiction.join(', ') %><% } %></p>
      <p>This is an original summary. It was published after editorial, evidence and source-rights review of this exact revision. It is not medical advice.</p>
    </details>
    <% if (article.tags.length) { %><p class="muted">Tags: <%= article.tags.join(', ') %></p><% } %>
  </article>
  <%- include('partials/sponsor-slot', { placements: typeof sponsorPlacements === 'undefined' ? [] : sponsorPlacements }) %>
</main>
<%- include('partials/site-bottom') %>
