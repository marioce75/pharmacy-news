<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Treatment evidence | PharmacyNews</title><style>
body{margin:0;background:#15161a;color:#eee;font:17px/1.6 system-ui}main{max-width:920px;margin:auto;padding:24px}a{color:#f5ad62}a:focus-visible,summary:focus-visible{outline:3px solid #cba5f0;outline-offset:5px}h1,h2{line-height:1.25}article,details,.notice{padding:18px;border:1px solid #66616e;margin:16px 0}summary{cursor:pointer;font-weight:bold}dt{font-weight:bold}dd{margin:0 0 12px}small{color:#ccc}.status{color:#d2b4ed}input{font:inherit;max-width:100%;padding:8px}button{font:inherit;padding:8px;background:#f5ad62;color:#111}li{overflow-wrap:anywhere}</style></head><body><main>
<a href="/">Back to global monitor</a><h1>Treatment evidence by disease</h1>
<p>Species, region and patient population matter. Medicines are not automatically ranked from news reports. This is a clinician-reviewed reference workflow, not personalised prescribing advice.</p>
<% if (preview) { %><div class="notice" role="status"><strong>LOCAL CLINICAL DRAFT — NOT APPROVED FOR CARE OR PUBLICATION.</strong> This preview exposes a separate assistant-prepared review draft. No prior news-story approval applies.</div><% } %>
<% if (query) { %><p>Selected disease: <strong><%= query %></strong>. Confirm the pathogen and population below; a similar disease name is not sufficient.</p><% } %>
<% if (!guides.length) { %><div class="notice"><h2>No reviewed treatment guide available</h2><p>No treatment recommendation is inferred. A clinical reviewer must prepare or approve disease-specific evidence before it can appear here. Return to the official outbreak source and local clinical/public-health guidance.</p></div><% } %>
<% guides.forEach(a=>{ const g=a.treatment; const expired=stale(g); %><article><h2><%= g.disease %></h2><p class="status"><%= preview ? 'Awaiting independent clinical, evidence, rights and editorial approvals' : 'Reviewed revision' %></p>
<dl><dt>Pathogen</dt><dd><%= g.pathogen %></dd><dt>Region / jurisdiction</dt><dd><%= g.region %></dd><dt>Population / setting</dt><dd><%= g.population %></dd><dt>Source checked / clinical review</dt><dd><%= g.checked_at %> / <%= a.clinical_review?.approved_at || 'Not reviewed' %></dd><dt>Review due</dt><dd><%= g.review_due %></dd></dl>
<% if(expired){ %><div class="notice" role="alert"><strong>Guidance review overdue.</strong> Treatment details are withheld until the evidence is refreshed and reviewed. Consult current official guidance.</div><% } else { keys.forEach(k=>{ const s=g.sections[k]; %><details><summary><%= labels[k] %> — <%= s.status.replaceAll('_',' ') %></summary><p><%= s.text %></p><p>Evidence: <% s.source_ids.forEach(id=>{const src=g.sources.find(x=>x.id===id);%><a href="<%= src.url %>" rel="noopener noreferrer"><%= src.issuer %> — <%= src.version %></a> <% }); %></p></details><% }); } %>
<h3>Source versions</h3><ul><% g.sources.forEach(s=>{ %><li><a href="<%= s.url %>" rel="noopener noreferrer"><%= s.issuer %> — <%= s.version %></a>; source date <%= s.published_at %></li><% }); %></ul><small>Original summary with source links. No patient-specific dosing or automatic treatment updates. Any content change requires new approvals.</small></article><% }); %>
</main></body></html>
